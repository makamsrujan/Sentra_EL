# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SENTRA_GEMINI_MODEL: Supported Gemini model alias for multimodal vision reasoning
# Defaults to gemini-3.8-flash; verify access in SENTRA diagnostics if changed.
SENTRA_GEMINI_MODEL="gemini-3.8-flash"

# GEMINI_STT_MODEL: Multimodal model for hardware audio speech-to-text (defaults to gemini-3.5-transcribe)
GEMINI_STT_MODEL="gemini-3.5-transcribe"

# GEMINI_TTS_MODEL: Speech generation model producing 24 kHz WAV audio (defaults to gemini-3.8-flash-lite-tts)
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"

# SENTRA_TTS_VOICE: Voice identifier for speech generation (e.g. Puck, Charon, Aoede, Kore, Fenrir)
SENTRA_TTS_VOICE="Puck"

# SENTRA_LIVE_MODEL: Live API model for real-time voice conversations (defaults to gemini-3.8-live)
SENTRA_LIVE_MODEL="gemini-3.8-live"

# SENTRA_LIVE_VOICE: Voice persona for real-time Gemini Live voice sessions (Zephyr, Puck, Charon, Kore, Fenrir)
SENTRA_LIVE_VOICE="Zephyr"

# SENTRA_OPERATOR_TOKEN: Required operator credential for /api/device/register, simulator writes, and /api/events deletion.
SENTRA_OPERATOR_TOKEN=""

# SENTRA_DEVICE_TOKEN: Provisioned authentication token required by ESP32-S3 hardware write endpoints.
# Generate a strong random secret before connecting physical hardware or exposing over a network.
SENTRA_DEVICE_TOKEN=""

# SENTRA_SIMULATOR_ENABLED: Enable/disable developer simulator endpoints ("true" or "false").
SENTRA_SIMULATOR_ENABLED="true"

# SENTRA_HEARTBEAT_TIMEOUT_MS: Milliseconds before an active device without telemetry is marked disconnected.
SENTRA_HEARTBEAT_TIMEOUT_MS="15000"

# SENTRA_DB_PATH: SQLite database file path for persistent telemetry, alerts, and memory.
SENTRA_DB_PATH="./data/sentra.db"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
