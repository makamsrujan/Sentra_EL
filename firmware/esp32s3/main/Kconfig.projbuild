# SENTRA device configuration. Never commit sdkconfig files containing secrets.
menu "SENTRA firmware configuration"

config SENTRA_WIFI_SSID
    string "Wi-Fi SSID"
    default ""

config SENTRA_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

config SENTRA_BACKEND_URL
    string "Backend origin (local HTTP only until TLS CA configured)"
    default ""

config SENTRA_DEVICE_ID
    string "Registered device ID"
    default "ESP32-S3-SENTRA-001"

config SENTRA_DEVICE_TOKEN
    string "Provisioned device token (secret; keep sdkconfig out of git)"
    default ""

config SENTRA_ENABLE_CAMERA
    bool "Enable OV2640 capture (requires verified board wiring)"
    default n

config SENTRA_ENABLE_VAD
    bool "Enable on-device voice activity detection"
    default n
    help
        Unavailable until a real voice activity detector is implemented.
        This flag is deliberately not interpreted as proof of wake-word support.

config SENTRA_ENABLE_INA219
    bool "Enable optional power monitor"
    default n
    help
        Requires implementation and verified INA219 wiring.

endmenu
