# SENTRA Separate ESP32-CAM Sender (Original ESP32 / ESP-32S AI-Thinker-style layout)
# Keep Wi-Fi credentials, tokens, and local sdkconfig out of Git.

CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

CONFIG_SENTRA_CAM_DEVICE_ID="ESP32-CAM-SENTRA-001"
CONFIG_SENTRA_CAM_FRAME_INTERVAL_MS=1200
CONFIG_SENTRA_CAM_JPEG_QUALITY=14
CONFIG_SENTRA_CAM_XCLK_HZ=20000000
CONFIG_SENTRA_CAM_MAX_UPLOAD_RETRIES=3
CONFIG_SENTRA_CAM_ENABLE_FLASH_LED=n

# Enable ESP-IDF root CA bundle so HTTPS backend URLs work alongside local HTTP
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
